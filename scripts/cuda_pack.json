  "platform": "win-x64",
  "cuda_major": 13,
  "install_dir": "<app support>/cuda_pack/",
  "layout": "all extracted DLLs flattened into install_dir (no sub-directories); the engine is given install_dir/onnxruntime.dll and LoadLibraryExW with LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR resolves the rest from that directory",
  "requirements": {
    "gpu": "NVIDIA GPU with compute capability >= 7.5 (Turing or newer). The ORT 1.31.1 CUDA 13 build ships SASS for sm_75/80/86/89/90/120 and PTX for sm_120 only; CUDA 13 itself dropped Maxwell, Pascal and Volta.",
    "min_compute_capability": "7.5",
    "driver_min_windows": "580.88",
    "min_cuda_driver_api": 13000,
    "driver_note": "CUDA 13.x libraries need an R580 or newer NVIDIA driver (CUDA 13.0 baseline; minor-version compatibility covers the 13.x libraries below). The app gates on the CUDA driver API version (cuDriverGetVersion >= 13000, ke_system_gpu_info_json cuda_driver_version); driver_min_windows is the first Windows R580 release, for the user-facing message.",
    "vc_redist": "MSVCP140.dll, VCRUNTIME140(_1).dll and MSVCP140_ATOMIC_WAIT.dll (Visual C++ 2022 x64 redistributable) - already required by the Flutter Windows runner",
    "optional_not_bundled": [
      "nvrtc64_13*_0.dll (only needed by ORT's JIT-fused SDPA/RmsNorm kernels, which none of the karaoke models use)",
      "curand64_10.dll (listed by the onnxruntime-gpu wheel's [cuda] extra; not referenced by onnxruntime_providers_cuda.dll)",
      "nvcuda.dll (comes with the driver)"
    ]
  },
